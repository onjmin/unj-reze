{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pokemon",
      "runtimeExecutable": "pnpx",
      "runtimeArgs": [
        "serve",
        "-p",
        "3456",
        "gomi/games"
      ],
      "port": 3456
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "dev-npm",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "4321"
      ],
      "port": 4321
    }
  ]
}