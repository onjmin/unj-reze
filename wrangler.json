{
    "name": "unj-reze",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-07-22",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "ratelimits": [
        {
            "name": "WRITE_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 30, "period": 10 }
        },
        {
            "name": "WRITE_LIMITER_STRICT",
            "namespace_id": "1002",
            "simple": { "limit": 5, "period": 10 }
        }
    ],
    "observability": {
        "logs": {
            "enabled": true,
            "invocation_logs": true
        }
    }
}
