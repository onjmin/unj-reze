{
    "name": "unj-reze",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-07-22",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "ratelimits": [
        {
            "name": "WRITE_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 30, "period": 10 }
        },
        {
            "name": "WRITE_LIMITER_STRICT",
            "namespace_id": "1002",
            "simple": { "limit": 5, "period": 10 }
        },
        {
            "name": "READ_LIMITER",
            "namespace_id": "1003",
            "simple": { "limit": 60, "period": 10 }
        },
        {
            "name": "WRITE_LIMITER_48",
            "namespace_id": "1004",
            "simple": { "limit": 240, "period": 10 }
        },
        {
            "name": "SIGNUP_LIMITER",
            "namespace_id": "1005",
            "simple": { "limit": 20, "period": 60 }
        },
        {
            "name": "DEDUPE_LIMITER",
            "namespace_id": "1006",
            "simple": { "limit": 1, "period": 60 }
        },
        {
            "name": "SIGNUP_LIMITER_48",
            "namespace_id": "1007",
            "simple": { "limit": 60, "period": 60 }
        },
        {
            "name": "READ_LIMITER_48",
            "namespace_id": "1008",
            "simple": { "limit": 480, "period": 10 }
        }
    ],
    "observability": {
        "logs": {
            "enabled": true,
            "invocation_logs": true
        }
    }
}
