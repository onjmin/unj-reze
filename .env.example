# ==============================================================================
# UNJ-REZE (RPGEN) 環境変数設定テンプレート
# ==============================================================================
# このファイルは .env にコピーして使う（.env は gitignore 済み、実際に読み込まれるのはこちら）。
# .env.production は本番(Cloudflare Workers)用のシークレット管理に使う（任意・gitignore済み）。
#
# 【ローカル開発の2つのモード】
# `docker compose up -d` すると、DBは db-neon(Postgres)、画像ストレージは minio(S3互換)が
# 立ち上がる。下のデフォルト値はそれらに向いているので、Neon/R2の契約が無くてもこのまま
# `pnpm dev` すれば動く。DATABASE_URL / R2_* を実サービスの値に差し替えれば、
# プロバイダ名（DATABASE_PROVIDER=neon, STORAGE_PROVIDER=r2）はそのままに接続先だけ本物へ
# 切り替わる（lib/db/pg.ts は DATABASE_URL のホストが localhost かどうかで自動判別、
# lib/storage/r2.ts は R2_ENDPOINT の有無で自動判別する）。
#
# 【デプロイ時の注意事項 (Cloudflare Workers)】
# 1. NEXT_PUBLIC_* 変数はビルド時 (pnpm build) にフロントエンドJS内に埋め込まれます。
#    デプロイ前には必ず .env.production に正しい設定値を記載した状態で pnpm build を実行してください。
# 2. サーバーサイド専用変数・シークレットは pnpm run deploy (wrangler secret bulk .env.production)
#    によって Cloudflare Workers の暗号化シークレットとして安全に同期されます。
# ==============================================================================

# ── データベース設定 (DATABASE_PROVIDER) ──
# mock  : メモリ上のモックデータを使用（外部サービス不要。docker-composeすら不要）
# neon  : PostgreSQL (Neon互換)。デフォルトはdocker-composeのdb-neon、本物のNeonにも切替可
DATABASE_PROVIDER=neon

# PostgreSQL (Neon) 接続文字列
# localhost を指しているときは lib/db/pg.ts が自動的に pg(node-postgres) 経由で
# db-neon(docker-compose)に直接繋ぐ。それ以外は @neondatabase/serverless の neon() を使う。
# 本物のNeonを使う場合は、Neonダッシュボードの接続文字列にそのまま差し替えるだけでよい。
DATABASE_URL=postgresql://neon:neon@localhost:5432/unj_reze

# ── KVプロバイダー (KV_PROVIDER) ──
# mock       : インメモリ Map (デフォルト。docker-composeにKV相当のサービスは無いので基本これでよい)
# cloudflare : Cloudflare KV REST API
KV_PROVIDER=mock
KV_ACCOUNT_ID=
KV_NAMESPACE_ID=
KV_API_TOKEN=

# ── オブジェクトストレージ (STORAGE_PROVIDER) ──
# local : ローカルファイルシステム ./public/uploads
# r2    : Cloudflare R2 (S3互換API)。デフォルトはdocker-composeのminio、本物のR2にも切替可
STORAGE_PROVIDER=r2

# R2/MinIO 接続設定
# R2_ENDPOINT が設定されていればそちらに繋ぐ（lib/storage/r2.ts、forcePathStyleも自動で立つ）。
# 本物のR2を使う場合は R2_ENDPOINT を空にして R2_ACCOUNT_ID を設定する
# （エンドポイントは https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com が自動生成される）。
R2_ENDPOINT=http://localhost:9000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=unj-reze
R2_PUBLIC_URL=http://localhost:9000/unj-reze

# ── テキストアップローダ (uploader-worker / R2) ──
# ゲーム/MVの manifest と MML本文の保存先。上の STORAGE_PROVIDER（画像）とは別系統で、
# ブラウザから直接 Worker を叩くため manifest が unj-reze のサーバーを通らない。
# すべて NEXT_PUBLIC_*（ビルド時にJSへ埋め込まれる）。
# UPLOAD_SECRET_PEPPER はフロントに露出する前提の難読化用であって機密ではない。
# 実際の防御は Worker 側のレート制限・リプレイ検知・サイズ検証が担う。
# ローカル開発ではこの機能自体を使わないなら空でよい（ゲーム/MV作成・保存がエラーになるだけ）。
NEXT_PUBLIC_UPLOADER_URL=
NEXT_PUBLIC_UPLOADER_CLIENT_ID=
NEXT_PUBLIC_UPLOADER_UPLOAD_SECRET_PEPPER=

# ── RPGEN アセット検索 ──
NEXT_PUBLIC_RPGEN_SEARCH_TOKEN=

# ── アプリ基本設定 ──
# 本番ドメイン（canonical URL / OGP / sitemap.xml / robots.txt 生成に使用）
NEXT_PUBLIC_SITE_URL=https://unj-reze.onjmin.workers.dev

# ── Anti-Abuse (Cloudflare Turnstile) ──
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── リアルタイムハブ (services/realtime / Koyeb) ──
# 未設定時は自動でslow pollingへフォールバックします。ローカル開発では基本空でよい。
# 1. REALTIME_URL: サーバー(API Route)から Koyeb ハブへの通知送信先 (https://)
# 2. NEXT_PUBLIC_REALTIME_URL: ブラウザ(JS)から Koyeb ハブへのWebSocket接続先 (wss://.../ws)
# 3. REALTIME_PUBLISH_SECRET: Koyeb ハブ /publish の共有シークレットキー (秘密鍵・絶対に公開不可)
REALTIME_URL=https://<koyeb-app>.koyeb.app
NEXT_PUBLIC_REALTIME_URL=wss://<koyeb-app>.koyeb.app/ws
REALTIME_PUBLISH_SECRET=your-realtime-secret-key
