# ==============================================================================
# UNJ-REZE (RPGEN) 環境変数設定テンプレート (.env / .env.production)
# ==============================================================================
# 【デプロイ時の注意事項 (Cloudflare Workers)】
# 1. NEXT_PUBLIC_* 変数はビルド時 (pnpm build) にフロントエンドJS内に埋め込まれます。
#    デプロイ前には必ず .env.production に正しい設定値を記載した状態で pnpm build を実行してください。
# 2. サーバーサイド専用変数・シークレットは pnpm run deploy (wrangler secret bulk .env.production)
#    によって Cloudflare Workers の暗号化シークレットとして安全に同期されます。
# ==============================================================================

# ── データベース設定 (DATABASE_PROVIDER) ──
# mock  : メモリ上のモックデータを使用 (デフォルト)
# neon  : PostgreSQL (Neon互換 / Docker db-neon)
# d1    : SQLite (Cloudflare D1互換)
DATABASE_PROVIDER=mock

# PostgreSQL (Neon) 接続文字列
DATABASE_URL=postgresql://neon:neon@localhost:5432/unj_reze

# SQLite (D1) ローカルパス
D1_DATABASE_PATH=./data/d1.sqlite

# ── KVプロバイダー (KV_PROVIDER) ──
# mock       : インメモリ Map (デフォルト)
# cloudflare : Cloudflare KV REST API
KV_PROVIDER=mock
KV_ACCOUNT_ID=
KV_NAMESPACE_ID=
KV_API_TOKEN=

# ── オブジェクトストレージ (STORAGE_PROVIDER) ──
# local : ローカルファイルシステム ./public/uploads (デフォルト)
# r2    : Cloudflare R2
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── RPGEN アセット検索 ──
NEXT_PUBLIC_RPGEN_SEARCH_TOKEN=

# ── アプリ基本設定 ──
# 本番ドメイン（canonical URL / OGP / sitemap.xml / robots.txt 生成に使用）
NEXT_PUBLIC_SITE_URL=https://unj-reze.onjmin.workers.dev

# ── Anti-Abuse (Cloudflare Turnstile) ──
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── リアルタイムハブ (services/realtime / Koyeb) ──
# 未設定時は自動でslow pollingへフォールバックします。
# 1. REALTIME_URL: サーバー(API Route)から Koyeb ハブへの通知送信先 (https://)
# 2. NEXT_PUBLIC_REALTIME_URL: ブラウザ(JS)から Koyeb ハブへのWebSocket接続先 (wss://.../ws)
# 3. REALTIME_PUBLISH_SECRET: Koyeb ハブ /publish の共有シークレットキー (秘密鍵・絶対に公開不可)
REALTIME_URL=https://<koyeb-app>.koyeb.app
NEXT_PUBLIC_REALTIME_URL=wss://<koyeb-app>.koyeb.app/ws
REALTIME_PUBLISH_SECRET=your-realtime-secret-key
