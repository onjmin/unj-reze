# データベースプロバイダー
# mock  : メモリ上のモックデータを使用 (default)
# neon  : PostgreSQL (Neon互換 / Docker db-neon)
# d1    : SQLite (Cloudflare D1互換)
DATABASE_PROVIDER=mock

# Neon (PostgreSQL) 接続設定
# Docker db-neon コンテナ使用時:
DATABASE_URL=postgresql://neon:neon@localhost:5432/unj_reze

# Cloudflare D1 (SQLite) 接続設定
D1_DATABASE_PATH=./data/d1.sqlite

# KVプロバイダー
# mock       : インメモリ Map (default)
# cloudflare : Cloudflare KV REST API
KV_PROVIDER=mock

# Cloudflare KV (KV_PROVIDER=cloudflare 時に必要)
KV_ACCOUNT_ID=
KV_NAMESPACE_ID=
KV_API_TOKEN=

# ストレージプロバイダー
# local : ローカルファイルシステム ./public/uploads (default)
# r2    : Cloudflare R2
STORAGE_PROVIDER=local

# Cloudflare R2 (STORAGE_PROVIDER=r2 時に必要)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

RPGEN_SEARCH_TOKEN=
NEXT_PUBLIC_RPGEN_SEARCH_TOKEN=

# 本番ドメイン（canonical URL / OGP / sitemap.xml / robots.txt 生成に使用）
NEXT_PUBLIC_SITE_URL=https://unj-reze.onjmin.workers.dev

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── リアルタイムハブ (services/realtime / Koyeb) ──
# 未設定なら push は無効になり、クライアントは従来どおりポーリングにフォールバックする。
# REALTIME_URL              : サーバー(API Route)からハブへ publish する先。http(s)。
# NEXT_PUBLIC_REALTIME_URL  : ブラウザがWS接続する先。ws(s)。/ws まで含める。
# REALTIME_PUBLISH_SECRET   : /publish の共有シークレット。ハブ側と同じ値にする。
REALTIME_URL=
NEXT_PUBLIC_REALTIME_URL=
REALTIME_PUBLISH_SECRET=
