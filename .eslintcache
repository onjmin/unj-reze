rity":1,"message":"1275","line":92,"column":6,"nodeType":"990","endLine":92,"endColumn":8,"suggestions":"1276","suppressions":"1277"},{"ruleId":"954","severity":1,"message":"1278","line":1,"column":8,"nodeType":"956","messageId":"957","endLine":1,"endColumn":13,"suggestions":"1279"},"@typescript-eslint/no-unused-vars","'setServer' is assigned a value but never used.","Identifier","unusedVar","react-hooks/set-state-in-effect","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\_own\\git\\_users\\onjmin\\unj-reze\\app\\page.tsx:58:16\n  56 |   useEffect(() => {\n  57 |     const saved = typeof localStorage !== 'undefined' ? localStorage.getItem('unj_bbs_mode') : null;\n> 58 |     if (saved) setBbsModeRaw(saved);\n     |                ^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  59 |   }, []);\n  60 |   const [notifCount, setNotifCount] = useState(0);\n  61 |   const [messageCount, setMessageCount] = useState(0);","'err' is defined but never used.","react-hooks/purity","Error: Cannot call impure function during render\n\n`Date.now` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\nC:\\_own\\git\\_users\\onjmin\\unj-reze\\app\\page.tsx:604:30\n  602 |\n  603 |             {currentNav === 'home' && (() => {\n> 604 |               const dayAgo = Date.now() - 24 * 60 * 60 * 1000;\n      |                              ^^^^^^^^^^ Cannot call impure function\n  605 |               const recentPosts = posts.filter(p => new Date(p.createdAt).getTime() >= dayAgo);\n  606 |               const latestThreadCount = recentPosts.length;\n  607 |               const latestReplyCount = recentPosts.reduce((sum, p) => sum + p.repliesCount, 0);","@next/next/no-img-element","Using `<img>` could result in slower LCP and higher bandwidth. Consider using `<Image />` from `next/image` or a custom image loader to automatically optimize images. This may incur additional usage or cost from your provider. See: https://nextjs.org/docs/messages/no-img-element","JSXOpeningElement","prefer-const","'displayPosts' is never reassigned. Use 'const' instead.","useConst",{"range":"1280","text":"1281"},"'replyMap' is defined but never used.","jsx-a11y/alt-text","Image elements must have an alt prop, either with meaningful text, or an empty string for decorative images.",["1282"],["1283"],"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\_own\\git\\_users\\onjmin\\unj-reze\\components\\DemoNoticeModal.tsx:11:5\n   9 |\n  10 |   useEffect(() => {\n> 11 |     setVisible(true);\n     |     ^^^^^^^^^^ Avoid calling setState() directly within an effect\n  12 |   }, []);\n  13 |\n  14 |   const dismiss = () => {","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\_own\\git\\_users\\onjmin\\unj-reze\\components\\DialogueCutscene.tsx:99:5\n   97 |\n   98 |   useEffect(() => {\n>  99 |     setPortraitMap(prev => {\n      |     ^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  100 |       const next = { ...prev };\n  101 |       let changed = false;\n  102 |       for (const l of lines) {","react-hooks/rules-of-hooks","React Hook \"useRef\" is called conditionally. React Hooks must be called in the exact same order in every component render.","react-hooks/refs","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\_own\\git\\_users\\onjmin\\unj-reze\\components\\DialogueCutscene.tsx:127:3\n  125 |   // forwardRef 経由で advance を外部に公開（モバイル「次へ」ボタン用）\n  126 |   const advanceRef = useRef<() => void>(advance);\n> 127 |   advanceRef.current = advance;\n      |   ^^^^^^^^^^^^^^^^^^ Cannot update ref during render\n  128 |   useImperativeHandle(ref, () => ({ advance: () => advanceRef.current() }), []);\n  129 |\n  130 |   // Z キー / Enter キーでセリフ送り","React Hook \"useImperativeHandle\" is called conditionally. React Hooks must be called in the exact same order in every component render.","React Hook \"useEffect\" is called conditionally. React Hooks must be called in the exact same order in every component render.","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\_own\\git\\_users\\onjmin\\unj-reze\\components\\DotDrawingEditor.tsx:85:3\n  83 |   const [showImport, setShowImport] = useState(false);\n  84 |\n> 85 |   toolRef.current = tool;\n     |   ^^^^^^^^^^^^^^^ Cannot update ref during render\n  86 |   colorRef.current = color;\n  87 |   walkModeRef.current = walkMode;\n  88 |   walkPresetRef.current = walkPreset;","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\_own\\git\\_users\\onjmin\\unj-reze\\components\\DotDrawingEditor.tsx:86:3\n  84 |\n  85 |   toolRef.current = tool;\n> 86 |   colorRef.current = color;\n     |   ^^^^^^^^^^^^^^^^ Cannot update ref during render\n  87 |   walkModeRef.current = walkMode;\n  88 |   walkPresetRef.current = walkPreset;\n  89 |","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\_own\\git\\_users\\onjmin\\unj-reze\\components\\DotDrawingEditor.tsx:87:3\n  85 |   toolRef.current = tool;\n  86 |   colorRef.current = color;\n> 87 |   walkModeRef.current = walkMode;\n     |   ^^^^^^^^^^^^^^^^^^^ Cannot update ref during render\n  88 |   walkPresetRef.current = walkPreset;\n  89 |\n  90 |   const applyColor = (c: string) => {","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\_own\\git\\_users\\onjmin\\unj-reze\\components\\DotDrawingEditor.tsx:88:3\n  86 |   colorRef.current = color;\n  87 |   walkModeRef.current = walkMode;\n> 88 |   walkPresetRef.current = walkPreset;\n     |   ^^^^^^^^^^^^^^^^^^^^^ Cannot update ref during render\n  89 |\n  90 |   const applyColor = (c: string) => {\n  91 |     setColor(c);","react-hooks/exhaustive-deps","The ref value 'mountRef.current' will likely have changed by the time this effect cleanup function runs. If this ref points to a node rendered by React, copy 'mountRef.current' to a variable inside the effect, and use that variable in the cleanup function.","React Hook useEffect has a missing dependency: 'gridH'. Either include it or remove the dependency array.","ArrayExpression",["1284"],"react-hooks/immutability","Error: Cannot access variable before it is declared\n\n`syncLayerEntries` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\nC:\\_own\\git\\_users\\onjmin\\unj-reze\\components\\DotDrawingEditor.tsx:530:5\n  528 |       new oekaki.LayeredCanvas('レイヤー #1');\n  529 |     }\n> 530 |     syncLayerEntries();\n      |     ^^^^^^^^^^^^^^^^ `syncLayerEntries` accessed before it is declared\n  531 |     updateOnionSkin();\n  532 |   }, [walkActiveIndex, walkMode]);\n  533 |\n\nC:\\_own\\git\\_users\\onjmin\\unj-reze\\components\\DotDrawingEditor.tsx:655:3\n  653 |   // ── Animation ──\n  654 |\n> 655 |   const syncLayerEntries = () => {\n      |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 656 |     const entries = oekaki.getLayers().map(inst => ({\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 657 |       instance: inst,\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 658 |       name: inst.name,\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 659 |     })).reverse();\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 660 |     setLayerEntries(entries);\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 661 |     layerEntriesRef.current = entries;\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 662 |   };\n      | ^^^^^ `syncLayerEntries` is declared here\n  663 |\n  664 |   const captureFrame = (): FrameData => ({\n  665 |     layers: oekaki.getLayers().map(l => ({","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\_own\\git\\_users\\onjmin\\unj-reze\\components\\DotDrawingEditor.tsx:928:23\n  926 |       {animMode && (\n  927 |         <AnimationBar\n> 928 |           frameCount={framesRef.current.length}\n      |                       ^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  929 |           currentFrame={currentFrameRef.current}\n  930 |           fps={fpsRef.current}\n  931 |           isPlaying={isPlaying}","Error: Cannot access refs