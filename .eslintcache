ted (https://react.dev/reference/react/useRef).\n\nC:\\_own\\git\\_users\\onjmin\\unj-reze\\components\\GameMaker.tsx:999:3\n   997 |   const [showEnding, setShowEnding] = useState(false);\n   998 |   const endingRef = useRef<EndingScreenConfig | undefined>(undefined);\n>  999 |   endingRef.current = gameData.ending;\n       |   ^^^^^^^^^^^^^^^^^ Cannot update ref during render\n  1000 |   const [selectedTileId, setSelectedTileId] = useState(1);\n  1001 |   /** マップ編集タブでどちらのレイヤーに描画するか。'base'=地面(当たり判定あり) / 'overlay'=上層(プレイヤーより手前・半透明化)。 */\n  1002 |   const [editMapLayer, setEditMapLayer] = useState<'base' | 'overlay'>('base');","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\_own\\git\\_users\\onjmin\\unj-reze\\components\\GameMaker.tsx:1009:3\n  1007 |   const [selectedObjId, setSelectedObjId] = useState<string | null>(null);\n  1008 |   const selectedObjIdRef = useRef<string | null>(null);\n> 1009 |   selectedObjIdRef.current = selectedObjId;\n       |   ^^^^^^^^^^^^^^^^^^^^^^^^ Cannot update ref during render\n  1010 |   // ── イベントランタイム ──\n  1011 |   const [switchVals, setSwitchVals] = useState<Record<number, boolean>>({});\n  1012 |   const switchValsRef = useRef<Record<number, boolean>>({});","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\_own\\git\\_users\\onjmin\\unj-reze\\components\\GameMaker.tsx:1013:3\n  1011 |   const [switchVals, setSwitchVals] = useState<Recor